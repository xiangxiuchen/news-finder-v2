# NewsAPI 密钥 (必填)
# 申请地址: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# AI 提供商: claude 或 deepseek (二选一)
# claude = 用 Claude API  (申请: https://console.anthropic.com/)
# deepseek = 用 DeepSeek API (申请: https://platform.deepseek.com/api_keys)
AI_PROVIDER=deepseek

# Claude API 密钥 (如果用 claude 的话)
CLAUDE_API_KEY=your_claude_api_key_here

# DeepSeek API 密钥 (如果用 deepseek 的话)
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Apify API 密钥 (选填，用于抖音视频语音转文字)
# 注册: https://apify.com/  → 设置 → API Keys → 创建
# 免费额度: 每月 $5 免费使用金
APIFY_API_KEY=your_apify_api_key_here

# Google OAuth 客户端 ID (选填，用于Google Drive同步)
# 1. 前往 https://console.cloud.google.com/ 创建项目
# 2. 启用 Google Drive API
# 3. 创建 OAuth 2.0 凭据 (Web 应用类型)
# 4. 添加授权来源 http://localhost:3000
# 5. 复制客户端 ID 到此处
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
